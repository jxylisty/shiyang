# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
dist/
dist-app/
*.local
npm-debug.log*

# APP 打包构建缓存（scripts/build_app.py 写入上次用的后端地址）
frontend/.app_api_base

# 数据库为构建产物（scripts/build_db.py 可重建），不进仓库
*.db
*.db-shm
*.db-wal
*.sqlite
# 迁移/回填/重建时的自动备份（_migrate_20261105 / backfill_material_herb_id 等生成，3-15MB）
# 注意上面的 *.db 匹配不到「shiyang.db.bak-xxx」这种以 .bak 结尾的名字，必须单列。
# 已入库的两份历史种子（bak-before-rebuild / bak-sync-*）是显式例外。
*.db.bak-*
*.bak-migrate-*

# 运行时缓存（后端 embedding/chembl 等，随用随建，不入库）
data/cache/

# 例外：HERB 采集缓存以 gzip 形式入库（data/herb_ingest_*.json.gz，共约 2.6MB）。
# 理由：HERB 接口格式会变（2026-11-06 实测 form-urlencoded 全返回 null，必须 JSON body），
# 一旦外站变动 + 缓存丢失，新克隆就再也重建不出扩容数据。脚本侧由
# scripts/_cache_seed.py 在 data/cache/ 缺文件时自动解压还原。
!data/herb_ingest_*.json.gz

# SymMap 下载数据（scripts/fetch_symmap.py 可重建，第三方数据不入库）
data/symmap_smhb_v2.xlsx
data/symmap_smhb_v2.json

# 编辑器/系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 演示临时产物
gui-test-screenshots/

# 本地临时文件
logs_*.txt
.zcode/
